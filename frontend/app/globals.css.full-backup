/* =========================================================
   TEXT — PREMIUM MICRO INTERACTIONS
   ========================================================= */

/* ---------- MAIN HEADING ---------- */

.cv-vision-title {
  cursor: default;
}

.cv-vision-title .vision-word {
  display: block;

  transform-origin: left center;

  transition:
    transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
