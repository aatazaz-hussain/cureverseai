/* =========================================================
   VISION — NEW BIOLOGICAL INTELLIGENCE VISUAL
   Static / centered / contained
========================================================= */

.cv-vision-panel-visual {
  position: relative !important;
  min-width: 0;
  min-height: 510px;
  height: 100%;
  overflow: hidden !important;
  isolation: isolate;
}

/* Atmospheric center */

.cv-vision-panel-visual::before {
  content: "";
  position: absolute;

  left: 50%;
  top: 50%;

  width: 430px;
  height: 430px;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(224,82,90,.14) 0%,
      rgba(224,82,90,.055) 28%,
      transparent 68%
    );

  filter: blur(12px);

  pointer-events: none;
  z-index: 0;
}

/* Central coordinate system */

.cv-bio-system {
  position: absolute;

  left: 50%;
  top: 50%;

  width: 330px;
  height: 330px;

  transform: translate(-50%, -50%);

  z-index: 5;
}

/* Thin scientific crosshair */

.cv-bio-system::before {
  content: "";

  position: absolute;

  left: 50%;
  top: 0;
  bottom: 0;

  width: 1px;

  transform: translateX(-50%);

  background:
    linear-gradient(
      to bottom,
      transparent,
      rgba(110,231,242,.18),
      rgba(243,239,232,.12),
      transparent
    );
}

.cv-bio-system::after {
  content: "";

  position: absolute;

  top: 50%;
  left: 0;
  right: 0;

  height: 1px;

  transform: translateY(-50%);

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(224,82,90,.16),
      rgba(243,239,232,.12),
      transparent
    );
}


/* =========================================================
   ORBITS
========================================================= */

.cv-bio-orbit {
  position: absolute;

  left: 50%;
  top: 50%;

  width: 255px;
  height: 255px;

  border-radius: 50%;

  transform-origin: center;

  pointer-events: none;
}

.cv-bio-orbit-one {
  transform:
    translate(-50%, -50%)
    rotateX(68deg)
    rotateZ(12deg);

  border: 1px solid rgba(243,239,232,.48);
}

.cv-bio-orbit-two {
  transform:
    translate(-50%, -50%)
    rotateY(67deg)
    rotateZ(-18deg);

  border: 1px solid rgba(110,231,242,.38);
}

.cv-bio-orbit-three {
  transform:
    translate(-50%, -50%)
    rotateX(62deg)
    rotateY(25deg)
    rotateZ(-48deg);

  border: 1px solid rgba(224,82,90,.34);
}


/* =========================================================
   CENTRAL AI CORE
========================================================= */

.cv-bio-core {
  position: absolute;

  left: 50%;
  top: 50%;

  width: 118px;
  height: 118px;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  background:
    radial-gradient(
      circle at 35% 30%,
      rgba(255,255,255,.12),
      rgba(224,82,90,.12) 34%,
      rgba(8,10,11,.98) 76%
    );

  border: 1px solid rgba(224,82,90,.62);

  box-shadow:
    0 0 0 8px rgba(224,82,90,.025),
    0 0 45px rgba(224,82,90,.14),
    inset 0 0 30px rgba(224,82,90,.08);

  z-index: 20;
}

.cv-bio-core-glow {
  position: absolute;

  inset: -14px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(224,82,90,.13),
      transparent 68%
    );

  filter: blur(10px);

  z-index: -1;
}

.cv-bio-core-inner {
  position: absolute;

  inset: 0;

  display: flex;
  align-items: center;
  justify-content: center;
}

.cv-bio-core-inner small {
  position: absolute;

  top: 24px;

  font-size: 7px;
  font-weight: 700;

  letter-spacing: .22em;

  color: rgba(233,197,140,.72);
}

.cv-bio-core-inner strong {
  font-size: 38px;
  font-weight: 500;

  letter-spacing: -.06em;

  color: var(--white);

  line-height: 1;
}


/* =========================================================
   CONNECTING LINES
========================================================= */

.cv-bio-line {
  position: absolute;

  height: 1px;

  transform-origin: left center;

  opacity: .55;

  z-index: 3;
}

.cv-line-a {
  width: 100px;
  left: 4%;
  top: 34%;

  background: linear-gradient(
    90deg,
    transparent,
    rgba(224,82,90,.5)
  );

  transform: rotate(8deg);
}

.cv-line-b {
  width: 95px;
  right: 3%;
  top: 40%;

  background: linear-gradient(
    90deg,
    rgba(110,231,242,.45),
    transparent
  );

  transform: rotate(-7deg);
}

.cv-line-c {
  width: 85px;
  left: 8%;
  bottom: 27%;

  background: linear-gradient(
    90deg,
    transparent,
    rgba(233,197,140,.4)
  );

  transform: rotate(-9deg);
}

.cv-line-d {
  width: 90px;
  right: 5%;
  bottom: 29%;

  background: linear-gradient(
    90deg,
    rgba(224,82,90,.38),
    transparent
  );

  transform: rotate(10deg);
}

.cv-line-e {
  width: 135px;
  left: 50%;
  top: 50%;

  background: rgba(243,239,232,.10);

  transform:
    translate(-50%, -50%)
    rotate(90deg);
}


/* =========================================================
   NODES
========================================================= */

.cv-bio-node {
  position: absolute;

  width: 7px;
  height: 7px;

  border-radius: 50%;

  z-index: 8;
}

.cv-node-a {
  left: 3%;
  top: 32%;

  background: var(--red);
  box-shadow: 0 0 14px rgba(224,82,90,.7);
}

.cv-node-b {
  right: 2%;
  top: 39%;

  background: var(--cyan);
  box-shadow: 0 0 14px rgba(110,231,242,.7);
}

.cv-node-c {
  left: 7%;
  bottom: 26%;

  background: var(--gold);
  box-shadow: 0 0 14px rgba(233,197,140,.7);
}

.cv-node-d {
  right: 4%;
  bottom: 28%;

  background: var(--red);
  box-shadow: 0 0 14px rgba(224,82,90,.7);
}

.cv-node-e {
  left: 50%;
  top: 8%;

  transform: translateX(-50%);

  width: 5px;
  height: 5px;

  background: var(--white);
}


/* =========================================================
   MARKERS
========================================================= */

.cv-bio-marker {
  position: absolute;

  width: 3px;
  height: 3px;

  border-radius: 50%;

  opacity: .7;
}

.cv-marker-red {
  left: 24%;
  top: 18%;
  background: var(--red);
}

.cv-marker-cyan {
  right: 22%;
  bottom: 17%;
  background: var(--cyan);
}

.cv-marker-gold {
  left: 19%;
  bottom: 16%;
  background: var(--gold);
}


/* =========================================================
   LABELS
========================================================= */

.cv-bio-label {
  position: absolute;

  z-index: 30;

  font-size: 8px;
  font-weight: 700;

  letter-spacing: .18em;

  color: rgba(243,239,232,.38);

  white-space: nowrap;

  transition:
    color 200ms ease,
    letter-spacing 200ms ease;
}

.cv-bio-label:hover {
  color: var(--white);
  letter-spacing: .23em;
}

.cv-bio-label-top {
  top: 28px;
  left: 30px;
}

.cv-bio-label-bottom {
  right: 30px;
  bottom: 28px;
}


/* =========================================================
   TEXT HOVER
========================================================= */

.cv-vision-title .vision-word {
  opacity: 1 !important;
  visibility: visible !important;

  transition:
    color 240ms ease,
    transform 260ms cubic-bezier(.22,1,.36,1);
}

.cv-vision-title:hover .vision-word-one {
  color: #fff;
  transform: scale(1.025);
}

.cv-vision-title:hover .vision-word-two {
  color: var(--red-bright);
  transform: scale(1.025);
}

.cv-vision-copy p {
  opacity: 1 !important;
  visibility: visible !important;

  transition:
    color 220ms ease,
    transform 220ms ease;
}

.cv-vision-copy p:hover {
  color: var(--white);
  transform: scale(1.012);
}

.cv-vision-formula span,
.cv-vision-formula strong {
  display: inline-block;

  transition:
    color 200ms ease,
    transform 200ms ease;
}

.cv-vision-formula span:hover,
.cv-vision-formula strong:hover {
  transform: scale(1.08);
}

.cv-vision-formula span:nth-of-type(1):hover {
  color: var(--cyan);
}

.cv-vision-formula span:nth-of-type(2):hover {
  color: var(--violet);
}

.cv-vision-formula span:nth-of-type(3):hover {
  color: var(--gold);
}

.cv-vision-formula strong:hover {
  color: var(--red-bright);
}

.cv-vision-link {
  opacity: 1 !important;
  visibility: visible !important;

  transition:
    color 220ms ease,
    transform 240ms ease,
    gap 240ms ease;
}

.cv-vision-link:hover {
  color: var(--gold);
  transform: scale(1.035);
  gap: 22px;
}

.cv-vision-link strong {
  display: inline-block;

  transition:
    transform 240ms ease,
    color 220ms ease;
}

.cv-vision-link:hover strong {
  color: var(--gold);
  transform: translate(4px,-3px) scale(1.12);
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 900px) {
  .cv-bio-system {
    width: 290px;
    height: 290px;
  }

  .cv-bio-orbit {
    width: 225px;
    height: 225px;
  }
}

@media (max-width: 700px) {
  .cv-vision-panel-visual {
    min-height: 400px;
  }

  .cv-bio-system {
    width: 270px;
    height: 270px;
  }

  .cv-bio-orbit {
    width: 215px;
    height: 215px;
  }

  .cv-bio-core {
    width: 105px;
    height: 105px;
  }

  .cv-bio-core-inner strong {
    font-size: 34px;
  }
}

