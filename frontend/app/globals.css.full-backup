   ========================================================= */

.cv-vision-panel-visual .cv-visual-core {
  transition:
    transform 500ms cubic-bezier(0.22, 1, 0.36, 1),
    filter 500ms ease;
}

.cv-vision-panel-visual:hover .cv-visual-core {
  transform: translate(-50%, -50%) scale(1.035) !important;

  filter:
    drop-shadow(0 0 22px rgba(224, 82, 90, 0.14));
}


/* =========================================================
   ORBITAL HOVER
   ========================================================= */

.cv-vision-panel-visual .cv-visual-core-ring {
  transition:
    opacity 350ms ease,
    filter 350ms ease;
}

.cv-vision-panel-visual:hover .cv-visual-core-ring {
  filter:
    drop-shadow(0 0 5px rgba(243,239,232,0.20));
}


/* =========================================================
   PANEL LIGHT
   ========================================================= */

.cv-vision-panel-visual {
  isolation: isolate;
}

.cv-vision-panel-visual:hover::before {
  opacity: 1.25;
}


