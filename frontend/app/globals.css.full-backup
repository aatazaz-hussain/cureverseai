  opacity: 1 !important;
  visibility: visible !important;
  transform: none !important;
  animation: none !important;
}


/* ---------- HEADING HOVER ---------- */

.cv-vision-title .vision-word {
  cursor: default;

  transform-origin: left center;

  transition:
    color 220ms ease,
