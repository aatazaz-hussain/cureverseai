}


/* Rings are children of the core.
   DO NOT use left/top/translate on them.
   They already fill the core. */

.cv-vision-panel-visual .cv-visual-core-ring {
  position: absolute !important;

  inset: 0 !important;

  width: 100% !important;
  height: 100% !important;

  margin: 0 !important;

  transform-origin: center center !important;

  animation: none !important;
  transition: none !important;
}


