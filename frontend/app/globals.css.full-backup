@import "tailwindcss";

:root {
  --black: #07090b;
  --ink: #0c1013;
  --panel: #11171b;
  --panel-light: #182126;

  --white: #f3efe8;
  --muted: #9ca5a8;

  --red: #e0525a;
  --red-bright: #ff6670;
  --gold: #e9c58c;
  --cyan: #6ee7f2;
  --violet: #9b8cff;

  --line: rgba(243, 239, 232, 0.12);
  --glass: rgba(255, 255, 255, 0.045);
}

* {
  box-sizing: border-box;
}

html {
  background: var(--black);
  color: var(--white);
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  overflow-x: hidden;
  background: var(--black);
  color: var(--white);
  font-family: Arial, Helvetica, sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

button {
  border: 0;
}

/* =========================================================
   SITE
========================================================= */

.cv-site {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 15% 18%,
      rgba(224, 82, 90, 0.11),
      transparent 28%
    ),
    radial-gradient(
      circle at 84% 48%,
      rgba(110, 231, 242, 0.07),
      transparent 26%
    ),
    var(--black);
}

/* =========================================================
   NAV
========================================================= */

.cv-nav {
  position: fixed;
  z-index: 100;
  top: 0;
  left: 0;
  width: 100%;
  height: 78px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 42px;

  border-bottom: 1px solid rgba(255,255,255,0.08);

  background: rgba(7, 9, 11, 0.68);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.cv-brand {
  display: flex;
  align-items: center;
  gap: 11px;

  font-size: 16px;
  letter-spacing: -0.03em;
}

.cv-brand strong {
  font-weight: 600;
}

.cv-brand b {
  color: var(--red);
  font-weight: 700;
}

.cv-brand-mark {
  position: relative;

  width: 32px;
  height: 32px;

  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 9px;

  display: block;
}

.cv-brand-mark i {
  position: absolute;

  width: 11px;
  height: 11px;

  border: 2px solid var(--white);
  border-radius: 50%;
}

.cv-brand-mark i:first-child {
  left: 6px;
  top: 9px;
}

.cv-brand-mark i:last-child {
  right: 5px;
  top: 5px;

  border-color: var(--red);
}

.cv-nav-links {
  display: flex;
  align-items: center;
  gap: 42px;

  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: #b8bdbe;
}

.cv-nav-links a {
  position: relative;
  transition: color 180ms ease;
}

.cv-nav-links a::after {
  content: "";

  position: absolute;
  left: 0;
  bottom: -8px;

  width: 0;
  height: 1px;

  background: var(--red);

  transition: width 220ms ease;
}

.cv-nav-links a:hover {
  color: var(--white);
}

.cv-nav-links a:hover::after {
  width: 100%;
}

.cv-nav-action {
  display: flex;
  align-items: center;
  gap: 12px;

  padding: 11px 17px;

  border: 1px solid rgba(233,197,140,0.35);
  border-radius: 100px;

  color: var(--gold);

  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;

  transition:
    background 200ms ease,
    transform 200ms ease,
    border-color 200ms ease;
}

.cv-nav-action:hover {
  transform: translateY(-2px);
  border-color: var(--gold);
  background: rgba(233,197,140,0.08);
}

/* =========================================================
   HERO
========================================================= */

.cv-hero {
  position: relative;

  min-height: 100vh;
  height: 960px;

  overflow: hidden;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 120px 5vw 70px;
}

.cv-hero::before {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(7,9,11,0.92) 0%,
      rgba(7,9,11,0.4) 42%,
      rgba(7,9,11,0.72) 100%
    );

  z-index: 1;
  pointer-events: none;
}

.cv-hero-grid {
  position: absolute;
  inset: 0;

  opacity: 0.22;

  background-image:
    linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);

  background-size: 80px 80px;

  mask-image: linear-gradient(
    to bottom,
    black,
    transparent 88%
  );
}

.cv-hero-grid::after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    radial-gradient(
      circle at 50% 55%,
      transparent 0,
      rgba(7,9,11,0.35) 48%,
      rgba(7,9,11,0.95) 100%
    );
}

.cv-hero-glow {
  position: absolute;

  width: 650px;
  height: 650px;

  border-radius: 50%;

  filter: blur(100px);

  pointer-events: none;
}

.cv-glow-red {
  left: 8%;
  top: 22%;

  background: rgba(224,82,90,0.12);
}

.cv-glow-cyan {
  right: 3%;
  top: 35%;

  background: rgba(110,231,242,0.07);
}

.cv-hero-label {
  position: absolute;
  z-index: 5;

  top: 112px;
  left: 5vw;

  display: flex;
  align-items: center;
  gap: 9px;

  color: #aeb4b5;

  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.19em;
}

.cv-live-dot {
  width: 6px;
  height: 6px;

  border-radius: 50%;
  background: var(--red);

  box-shadow: 0 0 14px rgba(224,82,90,0.9);

  animation: livePulse 1.8s ease-in-out infinite;
}

@keyframes livePulse {
  0%,100% {
    opacity: 0.45;
    transform: scale(0.8);
  }

  50% {
    opacity: 1;
    transform: scale(1.25);
  }
}

.cv-hero-copy {
  position: absolute;
  z-index: 8;

  left: 2.8vw;
  top: 25%;

  width: min(500px, 38vw);

  pointer-events: none;
}

.cv-eyebrow,
.cv-kicker {
  display: block;

  margin: 0 0 18px;

  color: var(--gold);

  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.24em;
  text-transform: uppercase;
}

.cv-hero-copy h1 {
  margin: 0;

  display: flex;
  flex-direction: column;

  font-size: clamp(62px, 7.2vw, 118px);
  line-height: 0.8;
  font-weight: 700;
  letter-spacing: -0.075em;
}

.cv-hero-copy h1 span:nth-child(1) {
  color: var(--white);
}

.cv-outline-word {
  color: transparent;

  -webkit-text-stroke: 1px rgba(243,239,232,0.72);

  margin-left: 8vw;
}

.cv-hero-copy h1 span:nth-child(3) {
  color: var(--red);
  margin-left: 2vw;
}

.cv-hero-description {
  max-width: 390px;

  margin: 36px 0 0 4vw;

  color: #b7bdbe;

  font-size: 14px;
  line-height: 1.8;
}

.cv-hero-actions {
  pointer-events: auto;

  display: flex;
  gap: 12px;

  margin: 25px 0 0 4vw;
}

.cv-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14px;

  min-height: 48px;
  padding: 0 22px;

  border-radius: 100px;

  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.13em;
  text-transform: uppercase;

  transition:
    transform 200ms ease,
    box-shadow 200ms ease,
    background 200ms ease;
}

.cv-button:hover {
  transform: translateY(-3px);
}

.cv-button-primary {
  background: var(--red);
  color: white;

  box-shadow:
    0 12px 35px rgba(224,82,90,0.18);
}

.cv-button-primary:hover {
  background: var(--red-bright);
  box-shadow:
    0 16px 45px rgba(224,82,90,0.28);
}

.cv-button-ghost {
  border: 1px solid rgba(243,239,232,0.18);
  color: var(--white);
  background: rgba(255,255,255,0.025);
}

/* =========================================================
   BIO CORE
========================================================= */

.cv-bio-core {
  position: absolute;
  z-index: 3;

  left: 47%;
  top: 47%;

  width: 420px;
  height: 420px;

  transform-origin: center;

  transition: transform 100ms linear;

  pointer-events: none;
}

.cv-core-orbit {
  position: absolute;
  inset: 0;

  border: 1px solid rgba(233,197,140,0.17);
  border-radius: 50%;
}

.orbit-one {
  transform: rotateX(66deg) rotateZ(18deg);
}

.orbit-two {
  transform: rotateY(66deg) rotateZ(-25deg);
}

.orbit-three {
  transform: rotateX(74deg) rotateY(18deg);
}

.cv-core-nucleus {
  position: absolute;

  left: 50%;
  top: 50%;

  width: 108px;
  height: 108px;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  background:
    radial-gradient(
      circle at 35% 30%,
      rgba(255,255,255,0.2),
      transparent 35%
    ),
    radial-gradient(
      circle,
      rgba(224,82,90,0.75),
      rgba(112,27,35,0.2) 65%,
      transparent 70%
    );

  border: 1px solid rgba(224,82,90,0.65);

  box-shadow:
    0 0 55px rgba(224,82,90,0.25),
    inset 0 0 30px rgba(224,82,90,0.18);
}

.cv-core-nucleus small {
  font-size: 9px;
  letter-spacing: 0.18em;
  color: var(--gold);
}

.cv-core-nucleus strong {
  font-size: 29px;
  letter-spacing: -0.06em;
}

.cv-core-dna {
  position: absolute;

  left: 50%;
  top: 50%;

  width: 55px;
  height: 190px;

  transform: translate(-50%, -50%) rotate(-22deg);

  opacity: 0.6;
}

.cv-core-dna::before,
.cv-core-dna::after {
  content: "";

  position: absolute;

  top: 0;
  bottom: 0;

  width: 2px;

  border-radius: 50%;

  background: linear-gradient(
    to bottom,
    transparent,
    var(--cyan),
    transparent,
    var(--red),
    transparent
  );
}

.cv-core-dna::before {
  left: 8px;
  transform: rotate(13deg);
}

.cv-core-dna::after {
  right: 8px;
  transform: rotate(-13deg);
}

.cv-core-dna span {
  position: absolute;

  left: 11px;
  width: 33px;
  height: 1px;

  background: rgba(243,239,232,0.4);
}

.cv-core-dna span:nth-child(1) { top: 12%; }
.cv-core-dna span:nth-child(2) { top: 27%; }
.cv-core-dna span:nth-child(3) { top: 42%; }
.cv-core-dna span:nth-child(4) { top: 57%; }
.cv-core-dna span:nth-child(5) { top: 72%; }
.cv-core-dna span:nth-child(6) { top: 87%; }

.cv-character-field {
  position: absolute;
  z-index: 7;

  right: 0;
  bottom: 0;

  width: 62vw;
  height: 680px;

  pointer-events: none;
}

/* Every character uses the same visual treatment */
.cv-character {
  position: absolute;

  width: auto;
  object-fit: contain;

  user-select: none;
  -webkit-user-drag: none;

  filter:
    drop-shadow(0 30px 35px rgba(0, 0, 0, 0.55))
    drop-shadow(0 0 28px rgba(224, 82, 90, 0.08));

  transition:
    left 900ms cubic-bezier(0.22, 1, 0.36, 1),
    right 900ms cubic-bezier(0.22, 1, 0.36, 1),
    bottom 900ms cubic-bezier(0.22, 1, 0.36, 1),
    height 900ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 900ms cubic-bezier(0.22, 1, 0.36, 1),
    filter 500ms ease;

  will-change: left, right, transform;
}

/* =========================================================
   DEFAULT FORMATION

   GIRL 01 | BOY | GIRL 02
========================================================= */

.formation-default .character-girl-one {
  left: -4%;
  right: auto;
  bottom: 0;
  height: 500px;
  z-index: 1;
}

.formation-default .character-boy {
  left: 27%;
  right: auto;
  bottom: 0;
  height: 610px;
  z-index: 3;
}

.formation-default .character-girl-two {
  left: auto;
  right: -2%;
  bottom: 0;
  height: 515px;
  z-index: 2;
}

/* =========================================================
   LEFT CURSOR

   BOY | GIRL 01 | GIRL 02

   Boy moves into Girl 01's position.
   Girl 01 moves into Boy's position.
========================================================= */

.formation-left .character-girl-one {
  left: 27%;
  right: auto;
  bottom: 0;
  height: 500px;
  z-index: 3;
}

.formation-left .character-boy {
  left: -4%;
  right: auto;
  bottom: 0;
  height: 610px;
  z-index: 1;
}

.formation-left .character-girl-two {
  left: auto;
  right: -2%;
  bottom: 0;
  height: 515px;
  z-index: 2;
}

/* =========================================================
   RIGHT CURSOR

   GIRL 01 | GIRL 02 | BOY

   Boy moves into Girl 02's position.
   Girl 02 moves into Boy's position.
========================================================= */

.formation-right .character-girl-one {
  left: -4%;
  right: auto;
  bottom: 0;
  height: 500px;
  z-index: 1;
}

.formation-right .character-boy {
  left: auto;
  right: -2%;
  bottom: 0;
  height: 610px;
  z-index: 3;
}

.formation-right .character-girl-two {
  left: 27%;
  right: auto;
  bottom: 0;
  height: 515px;
  z-index: 2;
}

/* Small depth cue while changing formation */
.formation-left .character-boy,
.formation-right .character-boy {
  filter:
    drop-shadow(0 35px 45px rgba(0, 0, 0, 0.65))
    drop-shadow(0 0 32px rgba(224, 82, 90, 0.14));
}

.cv-character-field::after {
  content: "";

  position: absolute;

  left: 0;
  right: 0;
  bottom: 0;

  height: 90px;

  background: linear-gradient(
    to top,
    var(--black),
    transparent
  );

  pointer-events: none;
}

/* =========================================================
   HERO META
========================================================= */

.cv-hero-meta {
  position: absolute;
  z-index: 6;

  right: 4vw;
  top: 180px;

  display: flex;
  flex-direction: column;
  gap: 11px;

  color: rgba(243,239,232,0.45);

  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.17em;
}

.cv-hero-meta span:first-child {
  color: var(--red);
}

.cv-scroll-hint {
  position: absolute;
  z-index: 8;

  left: 5vw;
  right: 5vw;
  bottom: 28px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  color: rgba(243,239,232,0.48);

  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.cv-scroll-hint i {
  flex: 1;

  height: 1px;

  margin: 0 22px;

  background:
    linear-gradient(
      90deg,
      rgba(224,82,90,0.8),
      rgba(255,255,255,0.08)
    );
}

/* =========================================================
   PARTICLES
========================================================= */

.cv-particle {
  position: absolute;
  z-index: 2;

  width: 3px;
  height: 3px;

  border-radius: 50%;

  background: var(--gold);

  opacity: 0.35;

  animation: particleFloat linear infinite;
}

.cv-particle:nth-of-type(3n) {
  background: var(--red);
}

.cv-particle:nth-of-type(4n) {
  background: var(--cyan);
}

@keyframes particleFloat {
  0%,100% {
    transform: translate3d(0,0,0);
    opacity: 0.2;
  }

  50% {
    transform: translate3d(10px,-24px,0);
    opacity: 0.7;
  }
}

/* =========================================================
   INTRO
========================================================= */

.cv-intro {
  position: relative;

  min-height: 680px;

  padding: 150px 7vw;

  background:
    radial-gradient(
      circle at 75% 35%,
      rgba(155,140,255,0.08),
      transparent 28%
    ),
    var(--ink);

  border-top: 1px solid var(--line);
}

.cv-section-index {
  color: var(--red);

  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.2em;
}

.cv-intro-layout {
  max-width: 1250px;

  margin: 100px auto 0;

  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 10vw;
  align-items: end;
}

.cv-intro h2 {
  margin: 0;

  font-size: clamp(52px, 7vw, 105px);
  line-height: 0.92;
  letter-spacing: -0.065em;
  font-weight: 600;
}

.cv-intro h2 em {
  display: block;

  color: var(--gold);

  font-style: normal;

  padding-left: 8vw;
}

.cv-intro-text {
  padding-bottom: 8px;
}

.cv-intro-text p {
  max-width: 430px;

  margin: 0 0 22px;

  color: #c1c6c6;

  font-size: 15px;
  line-height: 1.85;
}

.cv-muted {
  color: var(--red) !important;
  font-size: 11px !important;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.cv-signal-line {
  max-width: 1250px;

  margin: 120px auto 0;

  display: flex;
  align-items: center;
  gap: 7px;
}

.cv-signal-line span {
  display: block;

  height: 2px;

  background: rgba(255,255,255,0.1);
}

.cv-signal-line span:nth-child(1) {
  width: 4%;
  background: var(--red);
}

.cv-signal-line span:nth-child(2) {
  width: 22%;
}

.cv-signal-line span:nth-child(3) {
  width: 7%;
  background: var(--gold);
}

.cv-signal-line span:nth-child(4) {
  width: 35%;
}

.cv-signal-line span:nth-child(5) {
  flex: 1;
  background: var(--cyan);
  opacity: 0.5;
}

/* =========================================================
   VISION — BIOLOGICAL INTELLIGENCE
========================================================= */

.cv-vision {
  position: relative;

  min-height: 720px;

  padding: 105px 7vw 55px;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 72% 50%,
      rgba(224,82,90,0.10),
      transparent 25%
    ),
    radial-gradient(
      circle at 85% 20%,
      rgba(110,231,242,0.06),
      transparent 24%
    ),
    linear-gradient(
      135deg,
      #080b0d 0%,
      #0d1216 52%,
      #090c0f 100%
    );

  border-top: 1px solid var(--line);
}

/* subtle technical texture */

.cv-vision::before {
  content: "";

  position: absolute;
  inset: 0;

  opacity: 0.35;

  background-image:
    linear-gradient(
      rgba(255,255,255,0.025) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,0.025) 1px,
      transparent 1px
    );

  background-size: 70px 70px;

  mask-image: radial-gradient(
    circle at 72% 50%,
    black,
    transparent 65%
  );

  pointer-events: none;
}

/* =========================================================
   HEADER
========================================================= */

.cv-vision-header {
  position: relative;
  z-index: 5;

  max-width: 1250px;

  margin: auto;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cv-vision-header .cv-section-index {
  color: var(--red);

  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.2em;
}

.cv-vision-status {
  display: flex;
  align-items: center;
  gap: 9px;

  color: rgba(243,239,232,0.38);

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.17em;
}

.cv-vision-status i {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: var(--cyan);

  box-shadow: 0 0 14px var(--cyan);

  animation: visionStatus 2s ease-in-out infinite;
}

@keyframes visionStatus {
  0%,100% {
    opacity: 0.35;
  }

  50% {
    opacity: 1;
  }
}

/* =========================================================
   GLASS PANEL
========================================================= */

.cv-vision-glass {
  position: relative;
  z-index: 4;

  max-width: 1250px;
  min-height: 510px;

  margin: 48px auto 0;

  display: grid;
  grid-template-columns: 1.05fr 0.95fr;

  overflow: hidden;

  border: 1px solid rgba(243,239,232,0.12);
  border-radius: 18px;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,0.065),
      rgba(255,255,255,0.018)
    );

  box-shadow:
    0 35px 100px rgba(0,0,0,0.35),
    inset 0 1px rgba(255,255,255,0.045);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.cv-vision-glass::before {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      110deg,
      transparent 35%,
      rgba(224,82,90,0.035) 50%,
      transparent 65%
    );

  pointer-events: none;
}

/* =========================================================
   CONTENT
========================================================= */

.cv-vision-content {
  position: relative;
  z-index: 5;

  padding: 75px 65px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  border-right: 1px solid rgba(243,239,232,0.08);
}

.cv-vision-title {
  display: flex;
  flex-direction: column;

  margin-bottom: 48px;
}

.vision-word {
  display: block;

  font-size: clamp(58px, 6vw, 92px);

  opacity: 1;
  transform: translateY(0);
  line-height: 0.86;

  font-weight: 600;

  letter-spacing: -0.075em;

  animation: none;
}







.cv-vision-copy {
  max-width: 525px;
}

.cv-vision-copy p {
  margin: 0 0 23px;

  font-size: 14px;
  line-height: 1.85;
}

.cv-vision-copy p:first-child {
  color: var(--white);

  font-size: 16px;
}

.cv-vision-copy p:nth-child(2) {
  color: var(--muted);
}

.cv-vision-formula {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 9px;

  margin-top: 34px;

  color: rgba(243,239,232,0.48);

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.13em;
}

.cv-vision-formula b {
  color: rgba(243,239,232,0.25);
}

.cv-vision-formula span:nth-of-type(1) {
  color: var(--cyan);
}

.cv-vision-formula span:nth-of-type(2) {
  color: var(--violet);
}

.cv-vision-formula span:nth-of-type(3) {
  color: var(--gold);
}

.cv-vision-formula strong {
  color: var(--red);
}

.cv-vision-link {
  display: inline-flex;
  align-items: center;
  gap: 18px;

  width: fit-content;

  margin-top: 38px;

  padding-bottom: 12px;

  color: var(--white);

  border-bottom: 1px solid rgba(233,197,140,0.45);

  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;

  transition:
    color 200ms ease,
    border-color 200ms ease,
    gap 220ms ease;
}

.cv-vision-link strong {
  color: var(--gold);

  font-size: 18px;
  font-weight: 400;

  transition: transform 220ms ease;
}

.cv-vision-link:hover {
  color: var(--gold);
  border-color: var(--gold);
  gap: 25px;
}

.cv-vision-link:hover strong {
  transform: translate(3px,-3px);
}

/* text entrance */

.vision-reveal {
  opacity: 0;
  transform: translateY(20px);
}














/* =========================================================
   VISION — CLEAN BIOLOGICAL INTELLIGENCE VISUAL
   Static / centered / contained
========================================================= */

.cv-vision-panel-visual {
  position: relative;
  min-height: 510px;
  height: 100%;
  overflow: hidden;
  isolation: isolate;

  background:
    radial-gradient(
      circle at 50% 50%,
      rgba(224,82,90,0.13),
      transparent 30%
    ),
    radial-gradient(
      circle at 50% 50%,
      rgba(110,231,242,0.055),
      transparent 58%
    );
}


/* =========================================================
   ATMOSPHERIC FIELD
========================================================= */

.cv-vision-panel-visual::before {
  content: "";

  position: absolute;
  left: 50%;
  top: 50%;

  width: 390px;
  height: 390px;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(224,82,90,0.16) 0%,
      rgba(224,82,90,0.055) 28%,
      transparent 68%
    );

  filter: blur(12px);

  pointer-events: none;

  z-index: 0;
}


/* =========================================================
   SCIENTIFIC CROSSHAIR
========================================================= */

.cv-vision-panel-visual::after {
  content: "";

  position: absolute;

  left: 14%;
  right: 14%;

  top: 50%;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(110,231,242,0.12),
      rgba(243,239,232,0.18),
      rgba(224,82,90,0.12),
      transparent
    );

  pointer-events: none;

  z-index: 1;
}


/* =========================================================
   CENTRAL BIOLOGICAL SYSTEM
========================================================= */

.cv-visual-core {
  position: absolute !important;

  left: 50% !important;
  top: 50% !important;

  width: 300px !important;
  height: 300px !important;

  margin: 0 !important;

  transform: translate(-50%, -50%) !important;

  perspective: 900px;

  overflow: visible !important;

  opacity: 1 !important;
  visibility: visible !important;

  animation: none !important;
  transition: none !important;

  z-index: 5;
}


/* =========================================================
   ORBIT RINGS
========================================================= */

.cv-visual-core-ring {
  position: absolute !important;

  inset: 0 !important;

  width: 100% !important;
  height: 100% !important;

  margin: 0 !important;

  border-radius: 50%;

  background: transparent;

  transform-origin: center center !important;

  animation: none !important;
  transition: none !important;

  opacity: 0.72;
}


/* Horizontal molecular orbit */

.cv-visual-core-ring.ring-1 {
  transform:
    rotateX(72deg)
    rotateZ(-12deg) !important;

  border:
    1px solid rgba(243,239,232,0.62);

  box-shadow:
    0 0 18px rgba(243,239,232,0.035);
}


/* Vertical cyan orbit */

.cv-visual-core-ring.ring-2 {
  transform:
    rotateY(68deg)
    rotateZ(18deg) !important;

  border:
    1px solid rgba(110,231,242,0.38);

  box-shadow:
    0 0 18px rgba(110,231,242,0.035);
}


/* Red diagonal orbit */

.cv-visual-core-ring.ring-3 {
  transform:
    rotateX(64deg)
    rotateY(25deg)
    rotateZ(55deg) !important;

  border:
    1px solid rgba(224,82,90,0.42);

  box-shadow:
    0 0 18px rgba(224,82,90,0.04);
}


/* =========================================================
   CENTRAL AI NUCLEUS
========================================================= */

.cv-visual-core-center {
  position: absolute !important;

  left: 50% !important;
  top: 50% !important;

  width: 112px !important;
  height: 112px !important;

  margin: 0 !important;

  transform: translate(-50%, -50%) !important;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    radial-gradient(
      circle at 38% 32%,
      rgba(255,255,255,0.12),
      rgba(224,82,90,0.13) 35%,
      rgba(6,8,10,0.96) 75%
    );

  border:
    1px solid rgba(224,82,90,0.62);

  box-shadow:
    0 0 0 8px rgba(224,82,90,0.025),
    0 0 45px rgba(224,82,90,0.16),
    inset 0 0 28px rgba(224,82,90,0.08);

  animation: none !important;
  transition: none !important;

  z-index: 20;
}


/* Tiny CV identifier */

.cv-visual-core-center small {
  position: absolute;

  top: 22px;

  font-size: 7px;
  font-weight: 700;

  letter-spacing: 0.22em;

  color: rgba(233,197,140,0.72);
}


/* AI word */

.cv-visual-core-center strong {
  font-size: 38px;

  font-weight: 500;

  letter-spacing: -0.055em;

  color: var(--white);

  line-height: 1;

  text-shadow:
    0 0 24px rgba(243,239,232,0.12);
}


/* =========================================================
   DNA STRUCTURE
========================================================= */

.cv-visual-dna {
  position: absolute !important;

  left: 50% !important;
  top: 50% !important;

  width: 48px !important;
  height: 175px !important;

  margin: 0 !important;

  transform:
    translate(-50%, -50%)
    rotate(-18deg) !important;

  opacity: 0.72;

  animation: none !important;

  z-index: 12;
}

.cv-visual-dna i {
  position: absolute;

  width: 100%;
  height: 1px;

  left: 0;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(110,231,242,0.72),
      rgba(243,239,232,0.72),
      transparent
    );
}


/* =========================================================
   SIGNAL LINES
========================================================= */

.cv-signal {
  position: absolute;

  height: 1px;

  opacity: 0.5;

  transform: none !important;

  animation: none !important;

  pointer-events: none;

  z-index: 3;
}

.cv-signal::after {
  content: "";

  position: absolute;

  width: 4px;
  height: 4px;

  top: -2px;

  border-radius: 50%;

  background: currentColor;

  box-shadow:
    0 0 12px currentColor;
}

.signal-one {
  width: 115px;
  left: 12%;
  top: 34%;

  color: var(--red);
  background: rgba(224,82,90,0.30);
}

.signal-one::after {
  right: 0;
}

.signal-two {
  width: 135px;
  right: 10%;
  top: 61%;

  color: var(--cyan);
  background: rgba(110,231,242,0.25);
}

.signal-two::after {
  left: 0;
}

.signal-three {
  width: 90px;
  left: 19%;
  top: 70%;

  color: var(--gold);
  background: rgba(233,197,140,0.25);
}

.signal-three::after {
  right: 0;
}


/* =========================================================
   LABELS
========================================================= */

.cv-visual-label {
  position: absolute;

  z-index: 30;

  opacity: 1 !important;
  visibility: visible !important;

  font-size: 8px;

  font-weight: 700;

  letter-spacing: 0.18em;

  color: rgba(243,239,232,0.36);

  white-space: nowrap;

  transition:
    color 200ms ease,
    letter-spacing 200ms ease;
}

.cv-visual-label:hover {
  color: var(--white);
  letter-spacing: 0.23em;
}

.label-top {
  top: 27px;
  left: 29px;
}

.label-bottom {
  right: 29px;
  bottom: 27px;
}


/* =========================================================
   TEXT HOVER — VISION
========================================================= */

.cv-vision-title .vision-word {
  opacity: 1 !important;
  visibility: visible !important;

  transform-origin: left center;

  transition:
    color 240ms ease,
    transform 260ms cubic-bezier(.22,1,.36,1);
}

.cv-vision-title:hover .vision-word-one {
  color: #ffffff;
  transform: scale(1.025);
}

.cv-vision-title:hover .vision-word-two {
  color: var(--red-bright);
  transform: scale(1.025);
}


.cv-vision-copy p {
  opacity: 1 !important;
  visibility: visible !important;

  transform-origin: left center;

  transition:
    color 220ms ease,
    transform 240ms cubic-bezier(.22,1,.36,1);
}

.cv-vision-copy p:hover {
  color: var(--white);
  transform: scale(1.012);
}


/* Formula */

.cv-vision-formula span,
.cv-vision-formula strong {
  display: inline-block;

  transition:
    color 200ms ease,
    transform 200ms ease;
}

.cv-vision-formula span:hover,
.cv-vision-formula strong:hover {
  transform: scale(1.10);
}

.cv-vision-formula span:nth-of-type(1):hover {
  color: var(--cyan);
}

.cv-vision-formula span:nth-of-type(2):hover {
  color: var(--violet);
}

.cv-vision-formula span:nth-of-type(3):hover {
  color: var(--gold);
}

.cv-vision-formula strong:hover {
  color: var(--red-bright);
}


/* Explore */

.cv-vision-link {
  opacity: 1 !important;
  visibility: visible !important;

  transition:
    color 220ms ease,
    transform 240ms ease,
    gap 240ms ease;
}

.cv-vision-link:hover {
  color: var(--gold);
  transform: scale(1.035);
  gap: 25px;
}

.cv-vision-link strong {
  display: inline-block;

  transition:
    transform 240ms ease,
    color 220ms ease;
}

.cv-vision-link:hover strong {
  color: var(--gold);
  transform: translate(4px,-3px) scale(1.12);
}


/* Glass */

.cv-vision-glass {
  transition:
    border-color 280ms ease,
    box-shadow 280ms ease;
}

.cv-vision-glass:hover {
  border-color: rgba(233,197,140,0.20);

  box-shadow:
    0 28px 80px rgba(0,0,0,0.28),
    inset 0 1px rgba(255,255,255,0.04);
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1100px) {

  .cv-visual-core {
    width: 250px !important;
    height: 250px !important;
  }

  .cv-vision-panel-visual .cv-visual-core-center {
    width: 100px !important;
    height: 100px !important;
  }

  .cv-visual-core-center strong {
    font-size: 34px;
  }
}


@media (max-width: 760px) {

  .cv-vision-panel-visual {
    min-height: 430px;
  }

  .cv-visual-core {
    width: 240px !important;
    height: 240px !important;
  }

  .cv-visual-core-ring {
    width: 100% !important;
    height: 100% !important;
  }

  .cv-vision-panel-visual .cv-visual-core-center {
    width: 96px !important;
    height: 96px !important;
  }
}

/* =========================================================
   DOMAINS
========================================================= */

.cv-domains {
  position: relative;

  min-height: 760px;

  padding: 110px 7vw;

  background:
    radial-gradient(
      circle at 70% 60%,
      rgba(110,231,242,0.055),
      transparent 32%
    ),
    #090d10;

  border-top: 1px solid var(--line);
}

.cv-section-heading {
  max-width: 1250px;

  margin: 0 auto 90px;

  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 60px;
}

.cv-section-heading h2 {
  margin: 0;

  font-size: clamp(50px, 6.5vw, 95px);
  line-height: 0.9;
  letter-spacing: -0.065em;
}

.cv-section-heading h2 span {
  color: var(--muted);
}

.cv-section-heading > p {
  width: 300px;

  margin: 0;

  color: var(--muted);

  font-size: 13px;
  line-height: 1.8;
}

.cv-domain-experience {
  max-width: 1250px;
  min-height: 520px;

  margin: auto;

  display: grid;
  grid-template-columns: 0.8fr 1.2fr;

  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.cv-domain-list {
  border-right: 1px solid var(--line);
}

.cv-domain-item {
  width: 100%;
  min-height: 104px;

  padding: 0 25px;

  display: grid;
  grid-template-columns: 40px 1fr auto 30px;
  align-items: center;
  gap: 15px;

  text-align: left;

  color: var(--muted);

  background: transparent;

  border-bottom: 1px solid var(--line);

  cursor: pointer;

  transition:
    color 220ms ease,
    background 220ms ease,
    padding 220ms ease;
}

.cv-domain-item:hover,
.cv-domain-item.is-active {
  color: var(--white);
  padding-left: 34px;
  background: rgba(255,255,255,0.035);
}

.cv-domain-item > span {
  color: var(--red);
  font-size: 10px;
  font-weight: 700;
}

.cv-domain-item strong {
  font-size: 20px;
  font-weight: 500;
  letter-spacing: -0.035em;
}

.cv-domain-item small {
  color: rgba(243,239,232,0.35);

  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.cv-domain-item i {
  color: var(--gold);

  font-size: 16px;
  font-style: normal;

  opacity: 0;

  transition: opacity 200ms ease;
}

.cv-domain-item:hover i,
.cv-domain-item.is-active i {
  opacity: 1;
}

.cv-domain-world {
  position: relative;

  min-height: 520px;

  overflow: hidden;

  display: flex;
  align-items: center;
  justify-content: center;
}

.cv-domain-world::before {
  content: "";

  position: absolute;

  width: 420px;
  height: 420px;

  border-radius: 50%;

  background: radial-gradient(
    circle,
    rgba(224,82,90,0.12),
    transparent 68%
  );

  filter: blur(12px);
}

.world-gold::before {
  background: radial-gradient(
    circle,
    rgba(233,197,140,0.13),
    transparent 68%
  );
}

.world-cyan::before {
  background: radial-gradient(
    circle,
    rgba(110,231,242,0.11),
    transparent 68%
  );
}

.world-violet::before {
  background: radial-gradient(
    circle,
    rgba(155,140,255,0.12),
    transparent 68%
  );
}

.world-cream::before {
  background: radial-gradient(
    circle,
    rgba(243,239,232,0.1),
    transparent 68%
  );
}

.cv-world-orbit {
  position: absolute;

  width: 350px;
  height: 350px;

  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 50%;

  animation: orbitSpin 18s linear infinite;
}

.cv-world-orbit::before,
.cv-world-orbit::after {
  content: "";

  position: absolute;

  inset: 34px;

  border: 1px dashed rgba(255,255,255,0.08);
  border-radius: 50%;
}

.cv-world-orbit::after {
  inset: 92px;
  border-style: solid;
}

@keyframes orbitSpin {
  to {
    transform: rotate(360deg);
  }
}

.cv-world-orbit span {
  position: absolute;

  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: var(--red);

  box-shadow: 0 0 18px currentColor;
}

.cv-world-orbit span:nth-child(1) {
  top: -3px;
  left: 50%;
}

.cv-world-orbit span:nth-child(2) {
  right: 12%;
  top: 25%;
  background: var(--cyan);
}

.cv-world-orbit span:nth-child(3) {
  bottom: 8%;
  left: 25%;
  background: var(--gold);
}

.cv-world-orbit span:nth-child(4) {
  left: 6%;
  top: 50%;
  background: var(--violet);
}

.cv-world-center {
  position: relative;
  z-index: 2;

  width: min(350px, 80%);

  text-align: center;
}

.cv-world-center small {
  color: var(--red);

  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.2em;
}

.cv-world-center h3 {
  margin: 15px 0;

  font-size: clamp(38px, 4vw, 65px);
  line-height: 0.9;
  letter-spacing: -0.06em;
}

.cv-world-center p {
  margin: 0 auto 28px;

  color: var(--muted);

  font-size: 12px;
  line-height: 1.8;
}

.cv-world-center a {
  display: inline-flex;
  align-items: center;
  gap: 12px;

  color: var(--gold);

  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.cv-world-center a span {
  font-size: 16px;
}

.cv-world-data {
  position: absolute;

  color: rgba(243,239,232,0.3);

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.18em;
  line-height: 1.8;
}

.cv-world-data b {
  display: block;
  color: rgba(243,239,232,0.65);
}

.data-one {
  left: 7%;
  top: 18%;
}

.data-two {
  right: 7%;
  bottom: 18%;
  text-align: right;
}

/* =========================================================
   INTELLIGENCE
========================================================= */

.cv-intelligence {
  position: relative;

  min-height: 900px;

  padding: 120px 7vw;

  background:
    linear-gradient(
      135deg,
      #080b0d 0%,
      #0c1115 50%,
      #080b0d 100%
    );

  border-top: 1px solid var(--line);
}

.cv-intelligence-top {
  max-width: 800px;
  margin: auto;

  text-align: center;
}

.cv-intelligence-top h2 {
  margin: 0;

  font-size: clamp(55px, 7vw, 105px);
  line-height: 0.88;
  letter-spacing: -0.07em;
}

.cv-intelligence-top h2 span {
  display: inline-block;
  color: var(--cyan);
  margin: 0 0.12em;
}

.cv-intelligence-top p {
  max-width: 510px;

  margin: 35px auto 0;

  color: var(--muted);

  font-size: 13px;
  line-height: 1.8;
}

.cv-intelligence-visual {
  position: relative;

  width: min(700px, 80vw);
  height: 700px;

  margin: 80px auto 0;
}

.cv-intelligence-ring {
  position: absolute;

  left: 50%;
  top: 50%;

  border-radius: 50%;

  transform: translate(-50%, -50%);

  border: 1px solid rgba(255,255,255,0.08);
}

.ring-a {
  width: 280px;
  height: 280px;
}

.ring-b {
  width: 470px;
  height: 470px;

  border-style: dashed;
}

.ring-c {
  width: 660px;
  height: 660px;

  opacity: 0.45;
}

.cv-intelligence-ring::after {
  content: "";

  position: absolute;

  left: 50%;
  top: -4px;

  width: 8px;
  height: 8px;

  transform: translateX(-50%);

  border-radius: 50%;

  background: var(--cyan);

  box-shadow: 0 0 22px var(--cyan);
}

.ring-b::after {
  background: var(--red);
  box-shadow: 0 0 22px var(--red);
}

.ring-c::after {
  background: var(--gold);
  box-shadow: 0 0 22px var(--gold);
}

.cv-intelligence-core {
  position: absolute;

  left: 50%;
  top: 50%;

  width: 180px;
  height: 180px;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  background:
    radial-gradient(
      circle at 35% 30%,
      rgba(255,255,255,0.18),
      transparent 25%
    ),
    radial-gradient(
      circle,
      rgba(110,231,242,0.14),
      rgba(224,82,90,0.1) 45%,
      rgba(7,9,11,0.96) 72%
    );

  border: 1px solid rgba(110,231,242,0.45);

  box-shadow:
    0 0 70px rgba(110,231,242,0.1),
    inset 0 0 50px rgba(110,231,242,0.06);
}

.cv-intelligence-core small {
  font-size: 8px;
  color: var(--gold);
  letter-spacing: 0.2em;
}

.cv-intelligence-core strong {
  font-size: 48px;
  letter-spacing: -0.08em;
}

.cv-intelligence-core span {
  margin-top: 4px;

  color: var(--muted);

  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.cv-intelligence-node {
  position: absolute;

  z-index: 4;

  min-width: 135px;
  padding: 14px 16px;

  background: rgba(10,14,17,0.82);

  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 10px;

  backdrop-filter: blur(12px);

  box-shadow: 0 15px 35px rgba(0,0,0,0.25);
}

.cv-intelligence-node span {
  display: block;

  margin-bottom: 6px;

  color: var(--muted);

  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.cv-intelligence-node b {
  color: var(--white);

  font-size: 12px;
  letter-spacing: -0.02em;
}

.node-a {
  left: 4%;
  top: 25%;
}

.node-a b {
  color: var(--gold);
}

.node-b {
  right: 2%;
  top: 18%;
}

.node-b b {
  color: var(--red);
}

.node-c {
  right: 2%;
  bottom: 24%;
}

.node-c b {
  color: var(--cyan);
}

.node-d {
  left: 4%;
  bottom: 20%;
}

.node-d b {
  color: var(--violet);
}

.cv-metrics {
  max-width: 1100px;

  margin: 60px auto 0;

  display: grid;
  grid-template-columns: repeat(4, 1fr);

  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.cv-metrics > div {
  min-height: 120px;

  padding: 25px;

  border-right: 1px solid var(--line);
}

.cv-metrics > div:last-child {
  border-right: 0;
}

.cv-metrics strong {
  display: block;

  color: var(--white);

  font-size: 35px;
  letter-spacing: -0.06em;
}

.cv-metrics span {
  display: block;

  margin-top: 9px;

  color: var(--muted);

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.14em;
}

/* =========================================================
   TEAM
========================================================= */

.cv-team {
  position: relative;

  min-height: 820px;

  padding: 115px 7vw;

  background:
    radial-gradient(
      circle at 50% 65%,
      rgba(224,82,90,0.11),
      transparent 32%
    ),
    #090c0f;

  border-top: 1px solid var(--line);
}

.cv-team-heading {
  position: relative;
  z-index: 5;

  max-width: 1250px;
  margin: auto;
}

.cv-team-heading h2 {
  margin: 0;

  font-size: clamp(60px, 8vw, 125px);
  line-height: 0.82;
  letter-spacing: -0.075em;
}

.cv-team-heading h2 span {
  color: var(--red);
  padding-left: 10vw;
}

.cv-team-stage {
  position: relative;

  max-width: 1250px;
  height: 650px;

  margin: -20px auto 0;
}

.cv-team-glow {
  position: absolute;

  left: 50%;
  bottom: 20px;

  width: 520px;
  height: 200px;

  transform: translateX(-50%);

  border-radius: 50%;

  background: rgba(224,82,90,0.1);

  filter: blur(60px);
}

.cv-team-person {
  position: absolute;
  bottom: 0;

  width: 33%;

  text-align: center;
}

.cv-team-person img {
  width: 100%;
  height: 590px;

  object-fit: contain;

  filter:
    drop-shadow(0 25px 30px rgba(0,0,0,0.55));

  transition:
    transform 350ms cubic-bezier(.2,.8,.2,1);
}

.cv-team-person:hover img {
  transform: translateY(-15px) scale(1.025);
}

.cv-team-person > div {
  position: absolute;

  bottom: 10px;

  padding: 8px 13px;

  background: rgba(7,9,11,0.8);

  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 100px;

  backdrop-filter: blur(10px);
}

.cv-team-person > div span {
  color: var(--red);

  font-size: 8px;
  font-weight: 700;

  margin-right: 8px;
}

.cv-team-person > div strong {
  font-size: 9px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.person-one {
  left: 0;
}

.person-two {
  left: 33.5%;
  z-index: 3;
}

.person-three {
  right: 0;
}

/* =========================================================
   FINAL
========================================================= */

.cv-final {
  position: relative;

  min-height: 760px;

  padding: 170px 7vw;

  overflow: hidden;

  text-align: center;

  background:
    radial-gradient(
      circle at 50% 70%,
      rgba(224,82,90,0.22),
      transparent 30%
    ),
    #07090b;

  border-top: 1px solid var(--line);
}

.cv-final-grid {
  position: absolute;
  inset: 0;

  opacity: 0.18;

  background-image:
    linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);

  background-size: 70px 70px;

  mask-image: radial-gradient(
    circle at center,
    black,
    transparent 75%
  );
}

.cv-final > *:not(.cv-final-grid):not(.cv-final-dna) {
  position: relative;
  z-index: 3;
}

.cv-final h2 {
  margin: 0;

  font-size: clamp(65px, 9vw, 135px);
  line-height: 0.84;
  letter-spacing: -0.08em;
}

.cv-final h2 span {
  color: var(--gold);
}

.cv-final p {
  max-width: 520px;

  margin: 35px auto;

  color: var(--muted);

  font-size: 14px;
  line-height: 1.8;
}

.cv-final-button {
  margin-top: 10px;
}

.cv-final-dna {
  position: absolute;

  left: 50%;
  bottom: -220px;

  width: 260px;
  height: 500px;

  transform: translateX(-50%) rotate(18deg);

  opacity: 0.2;
}

.cv-final-dna::before,
.cv-final-dna::after {
  content: "";

  position: absolute;

  top: 0;
  bottom: 0;

  width: 2px;

  background: linear-gradient(
    to bottom,
    transparent,
    var(--red),
    var(--gold),
    var(--cyan),
    transparent
  );
}

.cv-final-dna::before {
  left: 60px;
  transform: rotate(9deg);
}

.cv-final-dna::after {
  right: 60px;
  transform: rotate(-9deg);
}

.cv-final-dna span {
  position: absolute;

  left: 68px;

  width: 124px;
  height: 1px;

  background: var(--white);
}

.cv-final-dna span:nth-child(1) { top: 15%; }
.cv-final-dna span:nth-child(2) { top: 38%; }
.cv-final-dna span:nth-child(3) { top: 61%; }
.cv-final-dna span:nth-child(4) { top: 84%; }

/* =========================================================
   FOOTER
========================================================= */

.cv-footer {
  min-height: 90px;

  padding: 0 7vw;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-top: 1px solid var(--line);

  color: rgba(243,239,232,0.4);

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.14em;
}

.cv-footer .cv-brand {
  color: var(--white);
}

/* =========================================================
   PROGRESS
========================================================= */

.cv-progress {
  position: fixed;

  z-index: 200;

  left: 0;
  bottom: 0;

  width: 100%;
  height: 2px;

  transform-origin: left center;

  background: linear-gradient(
    90deg,
    var(--red),
    var(--gold),
    var(--cyan)
  );
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1000px) {
  .cv-nav {
    padding: 0 24px;
  }

  .cv-nav-links {
    gap: 20px;
  }

  .cv-character-field {
    right: -4vw;
    width: 68vw;
  }

  .cv-hero-copy {
    width: 55vw;
  }

  .cv-intro-layout {
    gap: 6vw;
  }
}

@media (max-width: 760px) {
  .cv-nav {
    height: 68px;
  }

  .cv-nav-links {
    display: none;
  }

  .cv-nav-action {
    padding: 9px 12px;
  }

  .cv-hero {
    height: 900px;
    min-height: 900px;
    padding: 100px 22px 60px;
  }

  .cv-hero-label {
    left: 22px;
    top: 92px;
  }

  .cv-hero-copy {
    left: 22px;
    top: 19%;

    width: calc(100% - 44px);
  }

  .cv-hero-copy h1 {
    font-size: clamp(58px, 17vw, 95px);
  }

  .cv-outline-word {
    margin-left: 10vw;
  }

  .cv-hero-description {
    margin-left: 3vw;
    max-width: 330px;
  }

  .cv-hero-actions {
    margin-left: 3vw;
    flex-wrap: wrap;
  }

  .cv-bio-core {
    left: 50%;
    top: 49%;

    width: 300px;
    height: 300px;
  }

  .cv-character-field {
    right: -12vw;
    bottom: -5px;

    width: 110vw;
    height: 410px;
  }

  .cv-character {
    height: 330px;
  }

  .cv-character-left {
    left: -2%;
    height: 300px;
  }

  .cv-character-center {
    left: 30%;
    height: 375px;
  }

  .cv-character-right {
    right: -2%;
    height: 320px;
  }

  .cv-hero-meta {
    display: none;
  }

  .cv-scroll-hint {
    left: 22px;
    right: 22px;
  }

  .cv-intro,
  .cv-domains,
  .cv-intelligence,
  .cv-team,
  .cv-final {
    padding-left: 22px;
    padding-right: 22px;
  }

  .cv-intro-layout {
    margin-top: 65px;

    grid-template-columns: 1fr;
    gap: 45px;
  }

  .cv-intro h2 {
    font-size: 58px;
  }

  .cv-intro h2 em {
    padding-left: 12vw;
  }

  .cv-section-heading {
    flex-direction: column;
    align-items: flex-start;
    gap: 25px;
  }

  .cv-section-heading > p {
    width: auto;
  }

  .cv-domain-experience {
    grid-template-columns: 1fr;
  }

  .cv-domain-list {
    border-right: 0;
  }

  .cv-domain-item {
    min-height: 82px;
  }

  .cv-domain-world {
    min-height: 450px;
  }

  .cv-intelligence {
    min-height: 900px;
  }

  .cv-intelligence-visual {
    width: 100%;
    height: 500px;
  }

  .ring-a {
    width: 190px;
    height: 190px;
  }

  .ring-b {
    width: 330px;
    height: 330px;
  }

  .ring-c {
    width: 470px;
    height: 470px;
  }

  .cv-intelligence-core {
    width: 130px;
    height: 130px;
  }

  .cv-intelligence-core strong {
    font-size: 36px;
  }

  .cv-intelligence-node {
    min-width: 105px;
    padding: 10px;
  }

  .node-a {
    left: 0;
  }

  .node-b {
    right: 0;
  }

  .node-c {
    right: 0;
  }

  .node-d {
    left: 0;
  }

  .cv-metrics {
    grid-template-columns: repeat(2, 1fr);
  }

  .cv-metrics > div:nth-child(2) {
    border-right: 0;
  }

  .cv-metrics > div:nth-child(-n + 2) {
    border-bottom: 1px solid var(--line);
  }

  .cv-team {
    min-height: 850px;
  }

  .cv-team-stage {
    height: 500px;
    margin-top: 30px;
  }

  .cv-team-person img {
    height: 400px;
  }

  .cv-team-person {
    width: 43%;
  }

  .person-one {
    left: -5%;
  }

  .person-two {
    left: 28%;
  }

  .person-three {
    right: -5%;
  }

  .cv-team-person > div {
    display: none;
  }

  .cv-footer {
    padding: 25px 22px;

    flex-direction: column;
    gap: 14px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}


/* =========================================================
   VISION — BIOLOGICAL VISUAL REVEAL
   Text stays static. Visual enters when section activates.
   ========================================================= */

.cv-vision-panel-visual {
  opacity: 0;
  transform: translateY(45px) scale(0.94);
  transform-origin: center;
  transition:
    opacity 900ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 1100ms cubic-bezier(0.22, 1, 0.36, 1);
}

.cv-vision.is-visible .cv-vision-panel-visual {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.cv-vision-panel-visual .cv-visual-core {
  opacity: 0;
  transform: scale(0.72) rotate(-8deg);
  transition:
    opacity 900ms ease 250ms,
    transform 1200ms cubic-bezier(0.22, 1, 0.36, 1) 250ms;
}

.cv-vision.is-visible .cv-visual-core {
  opacity: 1;
  transform: scale(1) rotate(0deg);
}

.cv-vision-panel-visual .cv-visual-label {
  opacity: 0;
  transition: opacity 700ms ease;
}

.cv-vision.is-visible .label-top {
  opacity: 1;
  transition-delay: 450ms;
}

.cv-vision.is-visible .label-bottom {
  opacity: 1;
  transition-delay: 700ms;
}

.cv-vision-panel-visual .cv-signal {
  opacity: 0;
  transform: scaleX(0);
  transform-origin: left center;
}

.cv-vision.is-visible .signal-one {
  opacity: 1;
  transform: scaleX(1);
  transition:
    opacity 500ms ease 550ms,
    transform 900ms cubic-bezier(0.22, 1, 0.36, 1) 550ms;
}

.cv-vision.is-visible .signal-two {
  opacity: 1;
  transform: scaleX(1);
  transition:
    opacity 500ms ease 700ms,
    transform 900ms cubic-bezier(0.22, 1, 0.36, 1) 700ms;
}

.cv-vision.is-visible .signal-three {
  opacity: 1;
  transform: scaleX(1);
  transition:
    opacity 500ms ease 850ms,
    transform 900ms cubic-bezier(0.22, 1, 0.36, 1) 850ms;
}

/* Give the biological system a living feel after entering */

.cv-vision.is-visible .cv-visual-core-ring {
  animation: visionRingDrift 7s ease-in-out infinite;
}

.cv-vision.is-visible .ring-2 {
  animation-delay: -1.5s;
}

.cv-vision.is-visible .ring-3 {
  animation-delay: -3s;
}

.cv-vision.is-visible .cv-visual-core-center {
  animation: visionCorePulse 3.8s ease-in-out infinite;
}

@keyframes visionRingDrift {
  0%, 100% {
    transform: rotate(0deg) scale(1);
  }

  50% {
    transform: rotate(8deg) scale(1.035);
  }
}

@keyframes visionCorePulse {
  0%, 100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.07);
  }
}

@media (prefers-reduced-motion: reduce) {
  .cv-vision-panel-visual,
  .cv-vision-panel-visual .cv-visual-core {
    transition: none;
    opacity: 1;
    transform: none;
  }

  .cv-vision-panel-visual .cv-visual-label,
  .cv-vision-panel-visual .cv-signal {
    opacity: 1;
    transform: none;
  }

  .cv-vision.is-visible .cv-visual-core-ring,
  .cv-vision.is-visible .cv-visual-core-center {
    animation: none;
  }
}


/* =========================================================
   VISION — STATIC MODE
   All entrance/motion animations disabled.
   ========================================================= */

.cv-vision *,
.cv-vision *::before,
.cv-vision *::after {
  animation: none !important;
  transition: none !important;
}

.cv-vision .vision-word,
.cv-vision .vision-reveal {
  opacity: 1 !important;
  transform: none !important;
}

.cv-vision .cv-vision-panel-visual,
.cv-vision .cv-vision-panel-visual .cv-visual-core,
.cv-vision .cv-vision-panel-visual .cv-visual-label,
.cv-vision .cv-vision-panel-visual .cv-signal {
  opacity: 1 !important;
  transform: none !important;
}


/* =========================================================
   VISION VISUAL — FIT INSIDE FRAME
   ========================================================= */

.cv-vision-panel-visual {
  position: relative;
  min-height: 510px;
  height: 100%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Keep the entire biological system inside the right panel */
.cv-vision-panel-visual .cv-visual-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 310px;
  height: 310px;
  transform: translate(-50%, -50%);
}

/* Keep orbital rings contained */
.cv-vision-panel-visual .cv-visual-core-ring {
  max-width: 100%;
  max-height: 100%;
}

/* DNA stays centered */
.cv-vision-panel-visual .cv-visual-dna {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

/* AI center stays properly inside the orbital system */
.cv-vision-panel-visual .cv-visual-core-center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

/* Labels remain inside the frame */
.cv-vision-panel-visual .cv-visual-label {
  position: absolute;
  z-index: 4;
}

.cv-vision-panel-visual .label-top {
  top: 24px;
  left: 28px;
}

.cv-vision-panel-visual .label-bottom {
  bottom: 24px;
  right: 28px;
}

/* Signals must not escape the panel */
.cv-vision-panel-visual .cv-signal {
  max-width: 180px;
}

/* Responsive scaling */
@media (max-width: 1100px) {
  .cv-vision-panel-visual .cv-visual-core {
    width: 270px;
    height: 270px;
  }
}

@media (max-width: 800px) {
  .cv-vision-glass {
    grid-template-columns: 1fr;
  }

  .cv-vision-content {
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .cv-vision-panel-visual {
    min-height: 420px;
  }

  .cv-vision-panel-visual .cv-visual-core {
    width: 260px;
    height: 260px;
  }
}


/* =========================================================
   VISION — FINAL VISUAL FIT
   Keep biological visualization centered inside its panel.
   ========================================================= */

.cv-vision-panel-visual {
  overflow: hidden;
  position: relative;
}

.cv-vision-panel-visual .cv-visual-core {
  position: absolute !important;
  left: 50% !important;
  top: 48% !important;
  width: 290px !important;
  height: 290px !important;
  transform: translate(-50%, -50%) !important;
}

/* Keep the center AI locked to the visual core */
.cv-vision-panel-visual .cv-visual-core-center {
  left: 50% !important;
  top: 50% !important;
  transform: translate(-50%, -50%) !important;
}

/* Keep the surrounding signal graphics within the panel */
.cv-vision-panel-visual .cv-signal {
  max-width: 150px;
}

/* Keep labels safely inside the frame */
.cv-vision-panel-visual .label-top {
  top: 26px !important;
  left: 28px !important;
}

.cv-vision-panel-visual .label-bottom {
  bottom: 24px !important;
  right: 28px !important;
}

@media (max-width: 1100px) {
  .cv-vision-panel-visual .cv-visual-core {
    width: 260px !important;
    height: 260px !important;
  }
}

@media (max-width: 800px) {
  .cv-vision-panel-visual {
    min-height: 420px;
  }

  .cv-vision-panel-visual .cv-visual-core {
    width: 250px !important;
    height: 250px !important;
    top: 50% !important;
  }
}


/* =========================================================
   CUREVERSEAI — VISION FINAL POLISH
   Contained biological visual + premium hover interactions
   ========================================================= */

/* ---------- SECTION POSITION ---------- */

.cv-vision {
  scroll-margin-top: 90px;
  padding-top: 125px;
}


/* ---------- BIOLOGICAL VISUAL CONTAINER ---------- */

.cv-vision-panel-visual {
  position: relative;
  min-width: 0;
  min-height: 510px;
  height: 100%;
  overflow: hidden !important;
  display: flex;
  align-items: center;
  justify-content: center;
  isolation: isolate;
}

/*
   The biological system itself becomes a contained
   instrument inside the right half of the glass.
*/

.cv-vision-panel-visual .cv-visual-core {
  position: absolute !important;

  left: 50% !important;
  top: 50% !important;

  width: 235px !important;
  height: 235px !important;

  transform: translate(-50%, -50%) !important;

  overflow: visible;
  z-index: 5;
}


/* Keep every orbital element inside the instrument */

.cv-vision-panel-visual .cv-visual-core-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 235px !important;
  height: 235px !important;
  max-width: 235px !important;
  max-height: 235px !important;
  transform-origin: center;
}


/* AI sphere */

.cv-vision-panel-visual .cv-visual-core-center {
  position: absolute !important;
  left: 50% !important;
  top: 50% !important;

  transform: translate(-50%, -50%) !important;

  z-index: 10;
}


/* DNA remains inside the system */

.cv-vision-panel-visual .cv-visual-dna {
  max-height: 205px;
  max-width: 80px;
  overflow: hidden;
}


/* ---------- VISUAL ATMOSPHERE ---------- */

.cv-vision-panel-visual::before {
  content: "";
  position: absolute;
  width: 420px;
  height: 420px;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(224, 82, 90, 0.10) 0%,
      rgba(224, 82, 90, 0.035) 34%,
      transparent 70%
    );

  filter: blur(12px);
  pointer-events: none;
  z-index: 0;
}


/* subtle scanning line */

.cv-vision-panel-visual::after {
  content: "";
  position: absolute;
  left: 12%;
  right: 12%;
  top: 50%;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(110, 231, 242, 0.16),
      rgba(224, 82, 90, 0.20),
      transparent
    );

  opacity: 0.65;
  pointer-events: none;
  z-index: 1;
}


/* ---------- LABELS ---------- */

.cv-vision-panel-visual .cv-visual-label {
  z-index: 15;
  transition:
    color 250ms ease,
    letter-spacing 250ms ease,
    opacity 250ms ease;
}

.cv-vision-panel-visual .cv-visual-label:hover {
  color: var(--white);
  letter-spacing: 0.22em;
}


/* ---------- VISION TITLE HOVER ---------- */

.cv-vision-title {
  cursor: default;
}

.cv-vision-title .vision-word {
  transition:
    transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
    letter-spacing 350ms ease,
    color 350ms ease;
}

.cv-vision-title:hover .vision-word-one {
  transform: translateX(5px);
  letter-spacing: -0.065em;
}

.cv-vision-title:hover .vision-word-two {
  transform: translateX(13px);
  color: var(--red-bright);
  letter-spacing: -0.065em;
}


/* ---------- BODY COPY ---------- */

.cv-vision-copy p {
  transition:
    color 250ms ease,
    transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
}

.cv-vision-copy p:hover {
  color: var(--white);
  transform: translateX(4px);
}


/* ---------- DATA / MODELS / EVIDENCE / INTELLIGENCE ---------- */

.cv-vision-formula {
  cursor: default;
}

.cv-vision-formula span,
.cv-vision-formula strong {
  position: relative;
  transition:
    color 220ms ease,
    transform 220ms ease,
    letter-spacing 220ms ease;
}

.cv-vision-formula span:hover,
.cv-vision-formula strong:hover {
  transform: translateY(-2px);
  letter-spacing: 0.20em;
}

.cv-vision-formula span::after,
.cv-vision-formula strong::after {
  content: "";
  position: absolute;
  left: 0;
  right: 100%;
  bottom: -5px;
  height: 1px;
  background: currentColor;

  transition: right 250ms ease;
}

.cv-vision-formula span:hover::after,
.cv-vision-formula strong:hover::after {
  right: 0;
}


/* ---------- EXPLORE VISION LINK ---------- */

.cv-vision-link {
  position: relative;
  width: fit-content;
  padding-bottom: 9px;

  transition:
    color 250ms ease,
    letter-spacing 250ms ease;
}

.cv-vision-link::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;

  width: 100%;
  height: 1px;

  background: var(--gold);

  transform: scaleX(0.35);
  transform-origin: left;

  transition:
    transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
    background 250ms ease;
}

.cv-vision-link:hover {
  color: var(--gold);
  letter-spacing: 0.16em;
}

.cv-vision-link:hover::after {
  transform: scaleX(1);
  background: var(--red);
}

.cv-vision-link strong {
  display: inline-block;
  transition:
    transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
    color 250ms ease;
}

.cv-vision-link:hover strong {
  transform: translate(6px, -5px);
  color: var(--gold);
}


/* ---------- GLASS PANEL HOVER ---------- */

.cv-vision-glass {
  transition:
    border-color 350ms ease,
    box-shadow 450ms ease,
    background 350ms ease;
}

.cv-vision-glass:hover {
  border-color: rgba(233, 197, 140, 0.20);

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,0.045),
      rgba(255,255,255,0.025)
    );

  box-shadow:
    0 25px 80px rgba(0,0,0,0.25),
    inset 0 0 50px rgba(255,255,255,0.012);
}


/* ---------- FOOTER SIGNALS ---------- */

.cv-vision-footer span {
  transition:
    color 220ms ease,
    letter-spacing 220ms ease;
  cursor: default;
}

.cv-vision-footer span:hover {
  color: var(--white);
  letter-spacing: 0.21em;
}


/* ---------- NAV HOVER ---------- */

.cv-vision ~ * {
  isolation: isolate;
}


/* ---------- RESPONSIVE ---------- */

@media (max-width: 1100px) {

  .cv-vision-panel-visual .cv-visual-core {
    width: 210px !important;
    height: 210px !important;
  }

  .cv-vision-panel-visual .cv-visual-core-ring {
    width: 210px !important;
    height: 210px !important;
    max-width: 210px !important;
    max-height: 210px !important;
  }
}


@media (max-width: 800px) {

  .cv-vision {
    padding-top: 105px;
  }

  .cv-vision-panel-visual {
    min-height: 400px;
  }

  .cv-vision-panel-visual .cv-visual-core {
    width: 220px !important;
    height: 220px !important;
  }

  .cv-vision-panel-visual .cv-visual-core-ring {
    width: 220px !important;
    height: 220px !important;
    max-width: 220px !important;
    max-height: 220px !important;
  }
}


/* ---------- ACCESSIBILITY ---------- */

@media (prefers-reduced-motion: reduce) {

  .cv-vision *,
  .cv-vision *::before,
  .cv-vision *::after {
    transition: none !important;
  }
}


/* =========================================================
   VISION — FINAL COMPOSITION FIX
   Keep ALL biological elements locked to the same center.
   ========================================================= */

/* Give the section enough clearance below fixed navigation */
.cv-vision {
  padding-top: 150px !important;
}

/* Right side becomes a true coordinate system */
.cv-vision-panel-visual {
  position: relative !important;
  overflow: hidden !important;
  display: block !important;
}

/* One central biological instrument */
.cv-vision-panel-visual .cv-visual-core {
  position: absolute !important;

  left: 50% !important;
  top: 50% !important;

  width: 260px !important;
  height: 260px !important;

  margin: 0 !important;

  transform: translate(-50%, -50%) !important;

  overflow: visible !important;

  z-index: 5;
}


/* =========================================================
   ORBITAL RINGS
   All rings share EXACTLY the same center as the AI core.
   ========================================================= */

.cv-vision-panel-visual .cv-visual-core-ring {
  position: absolute !important;

  left: 50% !important;
  top: 50% !important;

  width: 260px !important;
  height: 260px !important;

  margin: 0 !important;

  transform-origin: center center !important;
}


/* Individual orbital orientations */

.cv-vision-panel-visual .ring-1 {
  transform: translate(-50%, -50%) rotate(0deg) !important;
}

.cv-vision-panel-visual .ring-2 {
  transform: translate(-50%, -50%) rotate(62deg) !important;
}

.cv-vision-panel-visual .ring-3 {
  transform: translate(-50%, -50%) rotate(-62deg) !important;
}


/* =========================================================
   CORE CENTER
   ========================================================= */

.cv-vision-panel-visual .cv-visual-core-center {
  position: absolute !important;

  left: 50% !important;
  top: 50% !important;

  margin: 0 !important;

  transform: translate(-50%, -50%) !important;

  z-index: 20;
}


/* =========================================================
   DNA
   ========================================================= */

.cv-vision-panel-visual .cv-visual-dna {
  position: absolute !important;

  left: 50% !important;
  top: 50% !important;

  margin: 0 !important;

  transform: translate(-50%, -50%) !important;

  z-index: 12;
}


/* =========================================================
   SIGNAL LINES
   Keep them behind the central instrument.
   ========================================================= */

.cv-vision-panel-visual .cv-signal {
  z-index: 2;
  pointer-events: none;
}


/* =========================================================
   VISUAL LABELS
   ========================================================= */

.cv-vision-panel-visual .label-top {
  top: 28px !important;
  left: 30px !important;
}

.cv-vision-panel-visual .label-bottom {
  bottom: 28px !important;
  right: 30px !important;
}


/* =========================================================
